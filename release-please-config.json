{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "always-update": true,
    "bump-minor-pre-major": true,
    "bump-patch-for-minor-pre-major": true,
    "group-pull-request-title-pattern": "\u2756 @ui-kit.ai/components v${version}",
    "include-component-in-tag": true,
    "include-v-in-tag": true,
    "pull-request-title-pattern": "\u2756 @ui-kit.ai/components v${version}",
    "release-type": "node",
    "tag-separator": "@",
    "changelog-sections": [
        { "section": "Features", "type": "feat" },
        { "section": "Bug Fixes", "type": "fix" },
        { "section": "Performance Improvements", "type": "perf" },
        { "section": "Reverts", "type": "revert" },
        { "section": "Miscellaneous Chores", "type": "chore" },
        { "section": "Documentation", "type": "docs" },
        { "section": "Styles", "type": "style" },
        { "section": "Code Refactoring", "type": "refactor" },
        { "section": "Tests", "type": "test" },
        { "section": "Build System", "type": "build" },
        { "section": "Continuous Integration", "type": "ci" }
    ],
    "packages": {
        ".": { "always-update": true, "component": "@ui-kit.ai/components" }
    }
}
