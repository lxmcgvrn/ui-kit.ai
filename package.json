{
    "name": "@ui-kit.ai/components",
    "version": "0.0.15",
    "description": "",
    "keywords": [],
    "homepage": "https://ui-kit.ai",
    "bugs": {
        "url": "https://github.com/alex-mcgovern/ui-kit.ai/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alex-mcgovern/ui-kit.ai"
    },
    "license": "MIT",
    "author": "Alex McGovern",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "main": "dist/index.js",
    "source": "src/components/index.ts",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm build:lib && pnpm build:docs",
        "build:docs": "cd src/docs && next build",
        "build:lib": "pnpm gen:theme && vite build",
        "check": "pnpm check:prettier && pnpm check:eslint && pnpm check:tsc && pnpm check:vitest",
        "check:eslint": "eslint .",
        "check:prettier": "prettier . --check",
        "check:tsc": "tsc && tsc -p src/docs",
        "check:vitest": "vitest run",
        "dev": "pnpm gen:theme && cd src/docs && next dev",
        "fix": "pnpm fix:prettier && pnpm fix:eslint",
        "fix:eslint": "eslint . --fix",
        "fix:prettier": "prettier . --write",
        "gen:theme": "tsx src/theme/gen-palette.ts",
        "prepare": "cd src/docs && fumadocs-mdx",
        "prepublishOnly": "pnpm build:lib",
        "smoke:pack": "./scripts/smoke-pack.sh"
    },
    "dependencies": {
        "@types/react-syntax-highlighter": "15.5.13",
        "lucide-react": "0.487.0",
        "react-aria-components": "1.10.1",
        "react-hook-form": "7.56.4",
        "react-markdown": "10.1.0",
        "react-syntax-highlighter": "15.6.1",
        "remark-gfm": "4.0.1",
        "tailwind-merge": "3.3.0",
        "tailwind-variants": "1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@hookform/resolvers": "5.0.1",
        "@tailwindcss/postcss": "4.1.9",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/culori": "4.0.0",
        "@types/hast": "3.0.4",
        "@types/mdx": "2.0.13",
        "@types/node": "22.15.17",
        "@types/react": "19.1.3",
        "@types/react-dom": "19.1.5",
        "@vitejs/plugin-react": "4.3.4",
        "csstype": "3.1.3",
        "culori": "4.0.1",
        "eslint": "10.8.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-comment-slop": "1.2.0",
        "eslint-plugin-jsdoc": "64.1.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-sonarjs": "4.2.0",
        "fumadocs-core": "15.8.5",
        "fumadocs-mdx": "12.0.3",
        "fumadocs-typescript": "4.0.12",
        "fumadocs-ui": "15.8.5",
        "globals": "17.11.0",
        "jsdom": "26.0.0",
        "msw": "2.8.2",
        "next": "15.5.23",
        "prettier": "3.5.3",
        "prettier-plugin-classnames": "0.7.7",
        "prettier-plugin-merge": "0.7.3",
        "prettier-plugin-packagejson": "2.5.10",
        "prettier-plugin-tailwindcss": "0.6.11",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "tailwindcss": "4.1.6",
        "tailwindcss-react-aria-components": "2.0.0",
        "tsx": "4.19.3",
        "typescript": "5.5.4",
        "typescript-eslint": "8.67.0",
        "vite": "6.2.2",
        "vite-plugin-dts": "4.5.3",
        "vitest": "3.0.8",
        "zod": "3.25.62"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "tailwindcss": "^4",
        "tailwindcss-react-aria-components": "^2"
    },
    "packageManager": "pnpm@10.6.3",
    "engines": {
        "node": "22.x"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "msw",
            "sharp"
        ]
    },
    "msw": {
        "workerDirectory": [
            "src/docs/public"
        ]
    }
}
