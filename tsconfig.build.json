{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "jsx": "preserve",
        "lib": ["ES2022", "dom", "dom.iterable"],
        "target": "ES2022",
        "types": ["@testing-library/jest-dom"]
    },
    // `src/theme` is here for its `Intent` type, which the components re-export;
    // the declaration bundle has to see it to inline it.
    "include": [
        "src/components/**/*",
        "src/theme/apca.ts",
        "src/theme/css.ts",
        "src/theme/index.ts",
        "src/theme/palette.ts",
        "src/theme/presets.ts",
        "src/theme/stylesheet.ts"
    ],
    // `src/docs` is the docs app — not part of the published bundle.
    "exclude": ["dist", "node_modules", "src/docs"]
}
