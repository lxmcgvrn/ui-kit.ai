{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "jsx": "preserve",
        "lib": ["ES2022", "dom", "dom.iterable"],
        "target": "ES2022",
        "types": ["@testing-library/jest-dom"]
    },
    // `src/theme` is here for its `Intent` type, which the components re-export;
    // the declaration bundle has to see it to inline it.
    "include": [
        "src/components/**/*",
        "src/theme/css.ts",
        "src/theme/index.ts",
        "src/theme/palette.ts"
    ],
    // `src/docs` is the docs app; `examples` folders are docs-only sources that
    // sit next to the components they document — neither is part of the bundle.
    "exclude": ["dist", "node_modules", "src/docs", "src/components/**/examples"]
}
